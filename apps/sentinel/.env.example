# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Environment
ENVIRONMENT=development
FLUTTER_ENV=development

# Feature Flags
ENABLE_RFID=true
ENABLE_OFFLINE_MODE=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_BACKGROUND_SYNC=true

# Debug Configuration
DEBUG_MODE=true
ENABLE_LOGGING=true
LOG_LEVEL=debug

# Sync Configuration
SYNC_INTERVAL_MINUTES=15
MAX_RETRY_ATTEMPTS=5
SYNC_BATCH_SIZE=50

# NFC Configuration
NFC_SESSION_TIMEOUT_SECONDS=5
NFC_AUTO_STOP=true

# Notification Configuration
FCM_TOPIC_PREFIX=sentinel_
NOTIFICATION_CHANNEL_ID=sentinel_notifications
NOTIFICATION_CHANNEL_NAME=Sentinel Notifications

# Security Configuration
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=3
ENCRYPTION_KEY_VERSION=1

# API Configuration
API_TIMEOUT_SECONDS=30
API_RETRY_COUNT=3
API_BASE_URL=

# Development Only
DEV_USE_EMULATOR=false
DEV_SKIP_ENCRYPTION=false
DEV_MOCK_OFFLINE_MODE=false

# Production Configuration (overrides)
# PROD_SUPABASE_URL=
# PROD_SUPABASE_ANON_KEY=
# PROD_LOG_LEVEL=info
# PROD_DEBUG_MODE=false